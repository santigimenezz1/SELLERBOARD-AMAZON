# Copia este archivo como .env.local y rellena los valores.
# .env.local está en .gitignore: NUNCA lo subas al repositorio.

# --- Firebase (cliente) ---
# Consola de Firebase → Configuración del proyecto → General → Tus apps → App web → "Configuración del SDK"
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Firebase Admin (solo servidor) ---
# Consola de Firebase → Configuración del proyecto → Cuentas de servicio → "Generar nueva clave privada".
# Del JSON descargado copia project_id, client_email y private_key (entre comillas, con los \n tal cual).
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# --- Amazon SP-API (solo servidor) ---
# Seller Central → Apps y servicios → Develop Apps → tu app.
# Usa un Client Secret REGENERADO y un Refresh Token nuevo ("Authorize app").
SPAPI_LWA_CLIENT_ID=
SPAPI_LWA_CLIENT_SECRET=
SPAPI_REFRESH_TOKEN=
# Región del endpoint: eu (Europa, por defecto), na (Norteamérica) o fe (Extremo Oriente).
SPAPI_REGION=eu

# Días hacia atrás que trae la PRIMERA sincronización (máx. 180). Las siguientes son incrementales.
SYNC_DIAS_INICIALES=90

# Gmail (solo lectura) para las notificaciones de performance de Amazon — opcional
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Clave larga y aleatoria para la sincronización programada (/api/cron/sync)
CRON_SECRET=

# Bot de Telegram para avisos de ventas (opcional). TELEGRAM_CHAT_ID solo si quieres fijar el chat
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Clave de la API de Claude (console.anthropic.com → API Keys) para leer los tickets de compra con IA
ANTHROPIC_API_KEY=
